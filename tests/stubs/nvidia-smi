#!/bin/bash
# Test stub for the commissioning scripts. Fixture-driven, no GPU required.
#   STUB_GPU_COUNT  number of GPUs to synthesise (default 8)
#   STUB_SMI_Q      fixture replayed for `-q`
#   STUB_SMI_ECC    fixture replayed for `-q -d ROW_REMAPPER,ECC` (defaults to $STUB_SMI_Q)
N="${STUB_GPU_COUNT:-8}"
Q="${STUB_SMI_Q:-tests/fixtures/smi-q-h100-full.txt}"
E="${STUB_SMI_ECC:-$Q}"
args="$*"

if [[ -z "$args" ]]; then
  cat <<'H'
Tue Aug 26 14:00:00 2026
+-----------------------------------------------------------------------------+
| NVIDIA-SMI 595.10       Driver Version: 595.10       CUDA Version: 12.8     |
|-----------------------------------------------------------------------------|
H
  exit 0
fi

# CSV queries first: "--query-gpu" contains the substring "-q", so matching the
# -q document cases ahead of these would swallow every bulk query.
if [[ "$args" == *--query-gpu=count* ]]; then echo "$N"; exit 0; fi

if [[ "$args" == *--query-gpu=persistence_mode* ]]; then
  for ((i=0;i<N;i++)); do echo "Enabled"; done
  exit 0
fi

if [[ "$args" == *--query-gpu=* ]]; then
  fields="${args#*--query-gpu=}"; fields="${fields%% *}"
  _only=""
  if [[ "$args" =~ (^|[[:space:]])-i[[:space:]]+([0-9]+) ]]; then _only="${BASH_REMATCH[2]}"; fi
  # Snapshot query signature: serve POST values from the 2nd call onward.
  # Must NOT match the single-field capability probes, which query one field at a
  # time -- otherwise probing consumes the pre/post transition.
  if [[ "$fields" == *ecc.errors.corrected.aggregate.total* \
     && "$fields" == *pcie.replay_counter* ]]; then
    _m="${STUB_SNAP_MARKER:-/tmp/stub-snap-called.$PPID}"
    if [[ -e "$_m" ]]; then
      STUB_ECC_UCE_AGG="${STUB_ECC_UCE_AGG_POST:-${STUB_ECC_UCE_AGG:-0}}"
      STUB_REMAP_UCE="${STUB_REMAP_UCE_POST:-${STUB_REMAP_UCE:-0}}"
      STUB_REPLAY="${STUB_REPLAY_POST:-${STUB_REPLAY:-0}}"
    fi
    touch "$_m"
  fi
  IFS=',' read -ra fs <<< "$fields"
  for ((i=0;i<N;i++)); do
    [[ -n "$_only" && "$i" != "$_only" ]] && continue
    row=""
    for f in "${fs[@]}"; do
      case "$f" in
        index)                   v="$i" ;;
        gpu_name|name)           v="NVIDIA H100 PCIe" ;;
        serial)                  v="157102345678$i" ;;
        uuid)                    v="GPU-3f1c8a20-1111-2222-3333-44445555666$i" ;;
        memory.total)            v="81559" ;;
        memory.free)             v="81036" ;;
        pcie.link.gen.current)   v="1" ;;
        pcie.link.gen.max)       v="4" ;;
        pcie.link.width.current) v="16" ;;
        pcie.link.width.max)     v="16" ;;
        temperature.gpu)         v="34" ;;
        power.draw)
            # STUB_LOADED_GPUS: comma list of GPUs that draw load power. Anything
            # else idles, which simulates a load generator covering only some cards.
            # If the load stub recorded which GPUs it was pinned to, believe that
            # over any static list -- it makes coverage reflect real launches.
            if [[ -n "$STUB_LOADED_FILE" && -s "$STUB_LOADED_FILE" ]]; then
              if grep -qx "$i" "$STUB_LOADED_FILE"; then v="${STUB_POWER_LOADED:-340.00}"
              else v="${STUB_POWER:-71.22}"; fi
            elif [[ -n "$STUB_LOADED_GPUS" ]]; then
              case ",$STUB_LOADED_GPUS," in *",$i,"*) v="${STUB_POWER_LOADED:-340.00}" ;;
                                            *)       v="${STUB_POWER:-71.22}" ;; esac
            else v="${STUB_POWER:-71.22}"; fi ;;
        power.limit)             v="${STUB_POWER_LIMIT:-350.00}" ;;
        vbios_version)           v="96.00.61.00.01" ;;
        ecc.mode.current)        v="${STUB_ECC_MODE:-Enabled}" ;;
        mig.mode.current)        v="${STUB_MIG_MODE:-Disabled}" ;;
        pci.bus_id)              v="00000000:$(printf '%02X' $((0x1B+i))):00.0" ;;
        temperature.memory)      v="${STUB_TEMP_MEM:-40}" ;;
        clocks.sm)               v="${STUB_CLOCK_SM:-1755}" ;;
        pcie.replay_counter)     v="${STUB_REPLAY:-0}" ;;
        remapped_rows.correctable)   v="${STUB_REMAP_CE:-0}" ;;
        remapped_rows.uncorrectable) v="${STUB_REMAP_UCE:-0}" ;;
        *ecc.errors.uncorrected.aggregate.total) v="${STUB_ECC_UCE_AGG:-0}" ;;
        *ecc.errors.corrected.aggregate.total)   v="${STUB_ECC_CE_AGG:-0}" ;;
        *sw_power_cap)               v="${STUB_TH_SWPC:-Active}" ;;
        *hw_thermal_slowdown)        v="${STUB_TH_HWTH:-Not Active}" ;;
        *hw_power_brake_slowdown)    v="${STUB_TH_HWPB:-Not Active}" ;;
        *sw_thermal_slowdown)        v="${STUB_TH_SWTH:-Not Active}" ;;
        *)                       v="0" ;;
      esac
      row+="${row:+, }$v"
    done
    echo "$row"
  done
  exit 0
fi

# `nvidia-smi -i N -q` reports GPU N's own identity, so rewrite the per-GPU
# fields to match what the CSV query returns for that index. Otherwise the
# report's serial cross-check correctly flags the stub as inconsistent.
_emit_q() {
  local fixture="$1" idx="${2:-}"
  if [[ -z "$idx" ]]; then cat "$fixture"; return; fi
  local bus
  bus=$(printf '%02X' $((0x1B + idx)))
  sed -e "s/1571023456789/157102345678${idx}/g"       -e "s/GPU-3f1c8a20-1111-2222-3333-444455556666/GPU-3f1c8a20-1111-2222-3333-44445555666${idx}/g"       -e "s/00000000:1B:00\.0/00000000:${bus}:00.0/g"       "$fixture"
}

_idx=""
if [[ "$args" =~ (^|[[:space:]])-i[[:space:]]+([0-9]+) ]]; then _idx="${BASH_REMATCH[2]}"; fi

if [[ "$args" == *"-q"* && "$args" == *ECC* ]]; then _emit_q "$E" "$_idx"; exit 0; fi
if [[ "$args" == *"-q"* ]];                     then _emit_q "$Q" "$_idx"; exit 0; fi
exit 0
