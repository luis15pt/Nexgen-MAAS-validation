# Copy this file to .env and fill in your values
# .env is git-ignored and will never be committed

# Used by reporting/device_certificate.py
MAAS_URL=http://maas.example.com:5240/MAAS
MAAS_API_KEY=consumer:token:secret

# Used by commissioning-scripts/80-nexgen-network-cabling-verify.sh
# Bake these into the script (edit defaults) before `maas commissioning-scripts create`,
# or override via environment when running the script locally for testing.
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=CHANGEME
